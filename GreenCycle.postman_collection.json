{
  "info": {
    "_postman_id": "greencycle-collection-v2",
    "name": "GreenCycle API",
    "description": "Test suite for the GreenCycle Go service: appliance CRUD, carbon-aware scheduling (single-zip and concurrent multi-zip), and the background scheduler.\n\nImport this file into Postman: File → Import → Upload Files.\n\nStart the stack first: `docker compose up --build` (or `go run ./cmd/server` against a local Postgres/Redis).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "scheduleId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Calculate — Dishwasher (85281 Phoenix AZ)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/calculate?appliance=Dishwasher&zip=85281",
          "host": ["{{baseUrl}}"],
          "path": ["calculate"],
          "query": [
            {"key": "appliance", "value": "Dishwasher"},
            {"key": "zip",       "value": "85281"}
          ]
        },
        "description": "Races every configured grid provider (context+select), caches the winning forecast in Redis, and runs the sliding-window algorithm. Response includes which provider answered."
      }
    },
    {
      "name": "2. Calculate — EV Charger (8-hour window)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/calculate?appliance=EV Charger&zip=90210",
          "host": ["{{baseUrl}}"],
          "path": ["calculate"],
          "query": [
            {"key": "appliance", "value": "EV Charger"},
            {"key": "zip",       "value": "90210"}
          ]
        },
        "description": "EV Charger has an 8-hour duration. The sliding window must find the cleanest consecutive 8-hour block."
      }
    },
    {
      "name": "3. Calculate — ERROR: Unknown appliance",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/calculate?appliance=Time Machine&zip=85281",
          "host": ["{{baseUrl}}"],
          "path": ["calculate"],
          "query": [
            {"key": "appliance", "value": "Time Machine"},
            {"key": "zip",       "value": "85281"}
          ]
        },
        "description": "Should return 400 Bad Request with a helpful error message listing how to see valid appliance names."
      }
    },
    {
      "name": "4. Calculate Multi — concurrent worker-pool fan-out",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/calculate/multi?appliance=Dryer&zips=85281,90001,10001,77001,60601",
          "host": ["{{baseUrl}}"],
          "path": ["calculate", "multi"],
          "query": [
            {"key": "appliance", "value": "Dryer"},
            {"key": "zips",      "value": "85281,90001,10001,77001,60601"}
          ]
        },
        "description": "Fetches every zip code concurrently through a bounded worker pool (default 5 workers), racing all configured providers for each one. Returns a per-zip breakdown plus the single greenest option."
      }
    },
    {
      "name": "5. List All Appliances",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/appliances",
          "host": ["{{baseUrl}}"],
          "path": ["appliances"]
        },
        "description": "Returns all appliances in Postgres. Should include the 6 seeded records from the 0002_seed_appliances migration."
      }
    },
    {
      "name": "6. Add Custom Appliance",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Hot Tub\",\n  \"durationHours\": 3.0\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": {
          "raw": "{{baseUrl}}/appliances",
          "host": ["{{baseUrl}}"],
          "path": ["appliances"]
        },
        "description": "Creates a new appliance at runtime. Returns 201 Created with the saved record including its auto-generated id."
      }
    },
    {
      "name": "7. Delete Appliance (replace {id})",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/appliances/7",
          "host": ["{{baseUrl}}"],
          "path": ["appliances", "7"]
        },
        "description": "Delete by ID. Replace '7' with the id returned by request #6. Returns 204 No Content on success."
      }
    },
    {
      "name": "8. Create Scheduled Run",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"applianceName\": \"Washing Machine\",\n  \"zip\": \"85281\",\n  \"webhookUrl\": \"https://webhook.site/YOUR-UNIQUE-ID\"\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": {
          "raw": "{{baseUrl}}/schedules",
          "host": ["{{baseUrl}}"],
          "path": ["schedules"]
        },
        "description": "Computes the optimal window via the same pipeline as /calculate, then persists it as a pending scheduled run. The background scheduler engine fires a webhook (+ writes a notification record) the moment the window starts. Get a free webhookUrl at https://webhook.site to watch it fire. webhookUrl is optional — omit it to fall back to SCHEDULER_WEBHOOK_URL."
      }
    },
    {
      "name": "9. List Scheduled Runs",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/schedules?status=pending",
          "host": ["{{baseUrl}}"],
          "path": ["schedules"],
          "query": [
            {"key": "status", "value": "pending", "description": "optional: pending | fired | failed | cancelled"}
          ]
        },
        "description": "Lists scheduled runs, optionally filtered by status."
      }
    },
    {
      "name": "10. Get Scheduled Run",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/schedules/{{scheduleId}}",
          "host": ["{{baseUrl}}"],
          "path": ["schedules", "{{scheduleId}}"]
        },
        "description": "Fetch one scheduled run by id — check its status to see whether the engine has fired it yet."
      }
    },
    {
      "name": "11. Cancel Scheduled Run",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/schedules/{{scheduleId}}",
          "host": ["{{baseUrl}}"],
          "path": ["schedules", "{{scheduleId}}"]
        },
        "description": "Cancels a run while it's still pending. Returns 204, or 404 if it's already fired/failed/cancelled."
      }
    },
    {
      "name": "12. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Liveness + dependency check. Reports Postgres and Redis connectivity."
      }
    }
  ]
}
