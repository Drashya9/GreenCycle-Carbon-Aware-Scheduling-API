# Copy to .env and fill in as needed. .env is gitignored — never commit real secrets.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080

# ── Postgres ────────────────────────────────────────────────────────────────
# Used directly by docker-compose to configure the postgres container.
POSTGRES_USER=greencycle
POSTGRES_PASSWORD=greencycle
POSTGRES_DB=greencycle
# Used by the app when NOT running via docker-compose (e.g. go run ./cmd/server).
DATABASE_URL=postgres://greencycle:greencycle@localhost:5432/greencycle?sslmode=disable

# ── Redis ───────────────────────────────────────────────────────────────────
# Falls back to KV_URL (what Vercel's Upstash integration injects) when unset.
REDIS_URL=redis://localhost:6379/0
FORECAST_CACHE_TTL=15m

# ── Grid providers ──────────────────────────────────────────────────────────
# Comma-separated list of providers to race concurrently for every /calculate call.
# Only providers with their required credentials set below are actually enabled.
GRID_PROVIDERS=mock

# https://www.electricitymaps.com/
ELECTRICITYMAPS_API_KEY=
# ELECTRICITYMAPS_BASE_URL=https://api.electricitymap.org/v3

# https://www.watttime.org/
WATTTIME_USERNAME=
WATTTIME_PASSWORD=
# WATTTIME_BASE_URL=https://api2.watttime.org/v2

# Requests/sec we allow ourselves to make to each real grid provider.
GRID_RATE_LIMIT_RPS=2
# How long /calculate waits for any provider to answer before giving up.
GRID_RACE_TIMEOUT=8s
# How many zip codes /calculate/multi fetches concurrently.
MULTIZONE_WORKERS=5

# ── Scheduler ───────────────────────────────────────────────────────────────
# How often the background engine checks for scheduled runs whose window has started.
SCHEDULER_POLL_INTERVAL=15s
# POSTed as JSON when a scheduled run fires (a scheduled run may override this per-request).
# Try https://webhook.site for a quick way to see payloads during local testing.
SCHEDULER_WEBHOOK_URL=
SCHEDULER_WEBHOOK_TIMEOUT=5s

# ── Serverless hosting (e.g. Vercel) ────────────────────────────────────────
# Defaults below match the Docker/Compose setup. On Vercel, set the first two to false:
# instances can't keep a background poll loop alive, and migrations run via cmd/migrate.
# RUN_MIGRATIONS=true
# SCHEDULER_ENABLED=true
# Enables GET /api/cron/tick (Authorization: Bearer <secret>), which runs one scheduler
# pass — point Vercel Cron or any external pinger at it. Unset = endpoint doesn't exist.
# When fired this way, set SCHEDULER_POLL_INTERVAL to the pinger's period (e.g. 1m) so a run
# is only flagged "fired late" if it's more than one period overdue.
CRON_SECRET=
